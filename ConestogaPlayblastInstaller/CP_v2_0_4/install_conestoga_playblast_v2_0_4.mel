// Conestoga Playblast Tool v2.0.4 - Drag & Drop Installer
// Usage: Drag this MEL file into a Maya viewport.

global proc string cstg_stripPrefix(string $value, string $prefix)
{
    if (`gmatch $value ($prefix + "*")`)
    {
        return `substring $value ((size($prefix) + 1)) (size($value))`;
    }
    return $value;
}

global proc installConestogaPlayblastV204()
{
    string $whatIs = `whatIs installConestogaPlayblastV204`;
    string $scriptPath = `cstg_stripPrefix $whatIs "Mel procedure found in: "`;

    if ($scriptPath == $whatIs)
    {
        warning "[Conestoga Playblast] Could not resolve installer path. Save the file locally and drag/drop again.";
        return;
    }

    string $sourceDir = `dirname $scriptPath`;

    string $pythonCmd = "import os, shutil, traceback\\n";
    $pythonCmd += "import maya.cmds as cmds\\n";
    $pythonCmd += "source_dir = r'" + $sourceDir + "'\\n";
    $pythonCmd += "version_folder = 'CP_v2_0_4'\\n";
    $pythonCmd += "required = ['conestoga_playblast.py','conestoga_playblast_ui.py','conestoga_playblast_presets.py']\\n";
    $pythonCmd += "maya_app_dir = os.path.normpath(cmds.internalVar(userAppDir=True))\\n";
    $pythonCmd += "scripts_dir = os.path.join(maya_app_dir, 'scripts')\\n";
    $pythonCmd += "install_root = os.path.join(scripts_dir, 'conestoga_playblast', version_folder)\\n";
    $pythonCmd += "os.makedirs(install_root, exist_ok=True)\\n";
    $pythonCmd += "missing = [f for f in required if not os.path.exists(os.path.join(source_dir, f))]\\n";
    $pythonCmd += "if missing:\\n";
    $pythonCmd += "    cmds.error('[Conestoga Playblast] Missing required files: {0}'.format(', '.join(missing)))\\n";
    $pythonCmd += "for filename in required:\\n";
    $pythonCmd += "    shutil.copy2(os.path.join(source_dir, filename), os.path.join(install_root, filename))\\n";
    $pythonCmd += "launcher_path = os.path.join(scripts_dir, 'conestoga_playblast', 'conestoga_playblast_latest.py')\\n";
    $pythonCmd += "with open(launcher_path, 'w') as launcher:\\n";
    $pythonCmd += "    launcher.write('import os, sys\\n')\\n";
    $pythonCmd += "    launcher.write('root = os.path.dirname(os.path.abspath(__file__))\\n')\\n";
    $pythonCmd += "    launcher.write(\"version_dir = os.path.join(root, 'CP_v2_0_4')\\n\")\\n";
    $pythonCmd += "    launcher.write('if version_dir not in sys.path:\\n    sys.path.insert(0, version_dir)\\n')\\n";
    $pythonCmd += "    launcher.write('from conestoga_playblast_ui import show_ui\\n')\\n";
    $pythonCmd += "    launcher.write('def launch():\\n    show_ui()\\n')\\n";
    $pythonCmd += "cmds.confirmDialog(title='Conestoga Playblast', message='Installation complete.\\nFiles installed to: ' + install_root, button=['OK'])\\n";
    $pythonCmd += "print('[Conestoga Playblast] Installed v2.0.4 to: {0}'.format(install_root))\\n";

    python($pythonCmd);
}

installConestogaPlayblastV204();
